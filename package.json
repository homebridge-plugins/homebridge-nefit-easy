{
  "name": "homebridge-nefit-easy",
  "version": "3.0.0",
  "description": "Homebridge plugin for Nefit Easy™ (aka Worcester Wave™, Junkers Control™)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "homebridge-plugin",
    "nefit easy",
    "worcester wave",
    "junkers control",
    "bosch"
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint src test",
    "test": "tsx --test --experimental-test-module-mocks test/*.test.ts",
    "watch": "npm run build && npm link && nodemon",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "repository": "homebridge-plugins/homebridge-nefit-easy",
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-nefit-easy/issues"
  },
  "homepage": "https://github.com/homebridge-plugins/homebridge-nefit-easy#readme",
  "author": "Robert Klep <robert@klep.name>",
  "license": "MIT",
  "dependencies": {
    "bosch-xmpp": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@homebridge/hap-nodejs": "^2.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
